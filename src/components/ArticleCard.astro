---
import type { Article } from '../lib/content';
import { articleHref, categoryLabels, formatDate, seriesLabel } from '../lib/content';

interface Props {
  article: Article;
  hideCategory?: boolean;
}

const { article, hideCategory = false } = Astro.props;
const series = seriesLabel(article.data.series);
const metaLabel = series ?? (hideCategory ? undefined : categoryLabels[article.data.category]);
---

<article class="article-card">
  <div class:list={['article-meta', { 'meta-date-only': !metaLabel }]}>
    {metaLabel && <span>{metaLabel}</span>}
    <time datetime={article.data.published.toISOString()}>{formatDate(article.data.published)}</time>
  </div>
  <h2><a href={articleHref(article)}>{article.data.title}</a></h2>
  <p>{article.data.description}</p>
  <a class="text-link" href={articleHref(article)}>Read article ↗</a>
</article>
